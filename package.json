{
  "name": "@animalabs/discord-mcpl",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "discord-mcpl": "./dist/src/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --target bun --minify --outfile dist/discord-mcpl.js",
    "typecheck": "tsc --noEmit",
    "test": "bunx tsx --test test/*.test.ts",
    "dev": "bun src/index.ts",
    "start": "bun dist/discord-mcpl.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@animalabs/mcpl-core": "^0.3.0",
    "discord.js": "^14.16.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostbloo/discord-mcpl.git"
  },
  "homepage": "https://github.com/ghostbloo/discord-mcpl#readme",
  "bugs": {
    "url": "https://github.com/ghostbloo/discord-mcpl/issues"
  }
}
